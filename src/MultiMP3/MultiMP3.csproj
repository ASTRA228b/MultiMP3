<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.3.0</Version>
    <ApplicationIcon>Assets/MultiMP3.ico</ApplicationIcon>
    <Authors>MultiMP3 contributors</Authors>
    <Description>Modern batch audio utility. Part of the ChudGPT ecosystem.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableUiTests)' == 'true'"><DefineConstants>$(DefineConstants);UI_TESTS</DefineConstants></PropertyGroup>
  <ItemGroup Condition="'$(EnableUiTests)' != 'true'"><Compile Remove="MainWindow.Smoke.cs"/><Compile Remove="MainWindow.Preview.cs"/></ItemGroup>
  <ItemGroup><Content Include="Assets/MultiMP3.ico" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
