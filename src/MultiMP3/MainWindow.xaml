<Window x:Class="MultiMP3.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MultiMP3" Width="1280" Height="860" MinWidth="1040" MinHeight="720" Background="#0b0c0b" Foreground="#f4f3ed" FontFamily="Arial" FontSize="13" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#141614" BorderBrush="#292c28" BorderThickness="0,0,1,0">
   <Grid Margin="20,30,20,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="11" Background="#A77AF5" Margin="0,0,10,0"><Viewbox Margin="8"><Path Stroke="#181122" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 2,11 L 2,19 M 8,4 L 8,26 M 14,8 L 14,22 M 20,0 L 20,30 M 26,11 L 26,19"/></Viewbox></Border><TextBlock Text="MultiMP3" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="A ChudGPT App" FontFamily="Consolas" FontSize="12" Foreground="#c7ff3e" Margin="1,14,0,30"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="LIBRARY" FontSize="10" Foreground="#979b95" Margin="12,0,0,12"/>
     <Button x:Name="DownloadsNav" Content="↓     Downloads" Tag="Downloads" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="#342744"/>
     <Button Content="▤     Albums" Tag="Albums" Click="Navigate" Margin="0,0,0,7" Background="Transparent"/>
     <Button Content="◷     History" Tag="History" Click="Navigate" Margin="0,0,0,7" Background="Transparent"/>
     <Border Height="1" Background="#292c28" Margin="10,20"/>
     <Button Content="⚙     Settings" Tag="Settings" Click="Navigate" Margin="0,0,0,7" Background="Transparent"/>
     <Button Content="!     Error Log" Tag="Error Log" Click="Navigate" Background="Transparent"/><Button Content="ⓘ     About" Tag="About" Click="Navigate" Background="Transparent" Margin="0,7,0,0"/>
    </StackPanel>
    <Border Grid.Row="3" Background="#141614" CornerRadius="10" Padding="15"><StackPanel><TextBlock Text="Made for your collection" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Local files. No accounts.&#x0a;Just your audio, in one place." Foreground="#91849F" FontSize="11" Margin="0,8,0,0" LineHeight="18"/><TextBlock x:Name="SidebarVersion" FontFamily="Consolas" Foreground="#B490EB" FontSize="9" Margin="0,16,0,0"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,27,32,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Right" VerticalAlignment="Top"><TextBlock FontFamily="Consolas" Text="SOURCE MODE" Foreground="#9683AC" FontSize="9" Margin="0,0,0,5"/><ComboBox x:Name="ModeCombo" Width="235" SelectionChanged="ModeChanged" AutomationProperties.Name="Source mode"/></StackPanel><StackPanel><TextBlock x:Name="PageTitle" Text="Downloads" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="A better home for everything you listen to." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
   <Border x:Name="NoticePanel" Grid.Row="1" Background="#211C2A" CornerRadius="8" Padding="12,9" Margin="0,0,0,18"><TextBlock x:Name="Notice" Text="Checking download engine…" Foreground="#B9AACD" TextWrapping="Wrap" FontSize="12"/></Border>
   <Grid Grid.Row="2" x:Name="DownloadsPage">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="AudioInputCard" Background="#141614" CornerRadius="14" BorderBrush="#292c28" BorderThickness="1" Padding="22"><Grid>
     <StackPanel x:Name="YouTubeInputPanel"><DockPanel><TextBlock DockPanel.Dock="Right" FontFamily="Consolas" Text="01  /  ADD YOUR AUDIO" Foreground="#979b95" FontSize="10"/><TextBlock Text="One song. Or your whole playlist." FontSize="18" FontWeight="SemiBold"/></DockPanel><TextBlock Text="Paste YouTube videos, albums, or playlist share links, one per line." Foreground="{StaticResource Muted}" Margin="0,7,0,14"/>
      <TextBox x:Name="LinksInput" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" ToolTip="Paste public YouTube videos, album links, or playlist links to add all available tracks." AutomationProperties.Name="Video, album, or playlist links"/>
      <DockPanel Margin="0,14,0,0"><Button x:Name="AddLinksButton" DockPanel.Dock="Right" Content="＋  Add Links" Click="AddLinks" Background="#9385ff" Foreground="#160F20" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" Margin="0,0,12,0" Text="Album and playlist links add all available tracks to a named folder." Foreground="#979b95" VerticalAlignment="Center" FontSize="11"/></DockPanel>
     </StackPanel>
     <StackPanel x:Name="AmazonInputPanel" Visibility="Collapsed">
      <TextBlock Text="Your purchases. In one place." FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Choose MP3 files you already downloaded from Amazon Music." Foreground="{StaticResource Muted}" Margin="0,8,0,14"/>
      <Border Background="#231E2D" CornerRadius="8" Padding="14"><TextBlock Text="Original audio, tags, and cover art are preserved.&#x0a;Your source files stay where they are." Foreground="#B5A4C9" LineHeight="20"/></Border>
      <CheckBox x:Name="GroupLocalAlbums" Content="Organize using the album names inside the files" IsChecked="True" Checked="LocalGroupingChanged" Unchecked="LocalGroupingChanged" Margin="0,12"/>
      <StackPanel Orientation="Horizontal"><Button x:Name="AddMp3Button" Content="＋  Choose MP3s" Click="ChooseAmazonFiles" Background="#9385ff" Foreground="#160F20" FontWeight="SemiBold" Margin="0,0,10,0"/><Button x:Name="AddLocalFolderButton" Content="Choose Folder" Click="ChooseAmazonFolder"/><TextBlock Text="Add to queue, then Import All" Foreground="#91809F" Margin="16,0,0,0" VerticalAlignment="Center"/></StackPanel>
     </StackPanel>
    </Grid></Border>
    <Grid x:Name="AudioOptions" Grid.Row="1" Margin="0,18,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0"><TextBlock Text="AUDIO QUALITY" Foreground="#979b95" FontSize="9" Margin="0,0,0,7"/><ComboBox x:Name="QualityCombo" SelectionChanged="QualityChanged"/><TextBlock x:Name="OriginalQualityLabel" Text="Original MP3" Visibility="Collapsed" Padding="10,9" Foreground="#BDA0E5"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="ADD TO ALBUM" Foreground="#979b95" FontSize="9" Margin="0,0,0,7"/><ComboBox x:Name="AlbumCombo" SelectionChanged="AlbumChanged"/><TextBlock x:Name="AutomaticAlbumLabel" Text="From file tags" Visibility="Collapsed" Padding="10,9" Foreground="#BDA0E5"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="SAVE TO" Foreground="#979b95" FontSize="9" Margin="0,0,0,7"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="SelectFolder" Padding="12,9"/><TextBlock x:Name="FolderLabel" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#C1B7CD" Margin="10,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel></StackPanel>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ClearButton" Content="Clear Queue" Click="ClearQueue" Background="Transparent" Padding="10,6"/><Button Content="Retry Failed" Click="RetryFailed" Background="Transparent" Padding="10,6"/></StackPanel><TextBlock x:Name="QueueHeading" Text="Download queue" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <Grid Grid.Row="3"><ListBox x:Name="QueueList" SelectionMode="Single" PreviewMouseLeftButtonDown="QueueMouseDown" PreviewMouseMove="QueueMouseMove" AllowDrop="True" Drop="QueueDrop">
     <ListBox.ItemTemplate><DataTemplate><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
      <Border Width="42" Height="46" CornerRadius="8" Background="#332540" VerticalAlignment="Top"><Grid><TextBlock Text="♫" FontSize="25" Foreground="#B792E9" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Grid></Border>
      <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Url}" Foreground="#979b95" FontSize="10" Margin="0,4" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Destination}" Foreground="#9B8DAA" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}"/><ProgressBar Value="{Binding Progress}" Margin="0,9,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,10,0"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="{Binding Quality}" Foreground="#979b95" FontSize="10" Margin="0,6" HorizontalAlignment="Right"/><TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" Foreground="#979b95" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
      <Button Grid.Column="3" Content="×" Tag="{Binding}" Click="RemoveTrack" Background="Transparent" Padding="5" VerticalAlignment="Top" ToolTip="Remove from queue"/>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox><StackPanel x:Name="EmptyQueue" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="≋" FontSize="40" Foreground="#7C6099" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyQueueTitle" Text="Your next playlist starts here" FontSize="17" Margin="0,8" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyQueueHint" Text="Add some links above. We’ll take it from there." Foreground="#82768F" FontSize="12"/></StackPanel></Grid>
   </Grid>
   <Grid Grid.Row="2" x:Name="AlbumsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="＋  Add Album" Click="AddAlbum" Background="#9385ff" Foreground="#0b0c0b"/><TextBlock Text="Give every mood a folder." Foreground="#AAA0B7" VerticalAlignment="Center"/></DockPanel><ListBox Grid.Row="1" x:Name="AlbumsList"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Open" Tag="{Binding}" Click="OpenAlbum" Margin="4"/><Button Content="Rename" Tag="{Binding}" Click="RenameAlbum" Margin="4"/><Button Content="Delete" Tag="{Binding}" Click="DeleteAlbum" Margin="4"/></StackPanel><StackPanel><TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" Foreground="#9B80BC" FontSize="10" Margin="0,8,0,0"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   <Grid Grid.Row="2" x:Name="HistoryPage" Visibility="Collapsed"><ListBox x:Name="HistoryList"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="18"><Button DockPanel.Dock="Right" Content="Show Folder" Tag="{Binding Path}" Click="ShowHistoryFolder" VerticalAlignment="Center"/><StackPanel><TextBlock Text="{Binding Title}" FontSize="16"/><TextBlock Text="{Binding Time, StringFormat={}{0:g}}" Foreground="#A08CAF" Margin="0,6"/><TextBlock Text="{Binding Path}" Foreground="#91849E" TextWrapping="Wrap"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyHistory" Text="Completed downloads will appear here." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94869F"/></Grid>
   <ScrollViewer Grid.Row="2" x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="700" HorizontalAlignment="Left">
    <TextBlock Text="Download preferences" FontSize="21" Margin="0,0,0,15"/><TextBlock Text="Default quality" Foreground="#AFA1BF"/><ComboBox x:Name="SettingsQuality" Margin="0,8,0,18"/>
    <TextBlock Text="Default download folder" Foreground="#AFA1BF"/><TextBox x:Name="SettingsFolder" Margin="0,8,0,18" MinWidth="550"/>
    <TextBlock Text="Concurrent downloads (1–4)" Foreground="#AFA1BF"/><ComboBox x:Name="ConcurrencyCombo" Margin="0,8,0,18"/>
    <CheckBox x:Name="OpenFolderCheck" Content="Open destination folder after a completed batch"/><CheckBox x:Name="DuplicateCheck" Content="Ask before adding a duplicate link"/><CheckBox x:Name="RetryCheck" Content="Automatically retry failed downloads"/>
    <TextBlock Text="Maximum retries per item" Foreground="#AFA1BF"/><ComboBox x:Name="RetriesCombo" Margin="0,8,0,12"/>
    <CheckBox x:Name="MetadataCheck" Content="Embed title, artist, and album metadata"/><CheckBox x:Name="ThumbnailCheck" Content="Embed cover art when available"/>
    <TextBlock Text="Appearance: Charcoal / Audio violet" Foreground="#BDA2DB" Margin="0,14"/><Button x:Name="SaveSettingsButton" Content="Save Preferences" Click="SaveSettings" Background="#9385ff" Foreground="#0b0c0b" HorizontalAlignment="Left" Margin="0,0,0,24"/>
    <TextBlock Text="Download engine" FontSize="21"/><TextBlock Text="Install the media tools with Setup-Engine.cmd from the extracted app folder. Run it again when YouTube needs an extractor update, then recheck below. See README for manual setup." Foreground="#A89AB7" TextWrapping="Wrap" Margin="0,10"/><Button Content="Recheck Dependencies" Click="RecheckDependencies" HorizontalAlignment="Left"/><TextBlock x:Name="StorageLabel" Foreground="#979b95" TextWrapping="Wrap" Margin="0,14"/><TextBlock Text="Best Available uses high-quality variable-bitrate MP3. Higher output bitrates do not improve the quality of the source audio." Foreground="#979b95" TextWrapping="Wrap" Margin="0,0,0,20"/>
   </StackPanel></ScrollViewer>
   <ScrollViewer Grid.Row="2" x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
     <Border Background="#141614" BorderBrush="#292c28" BorderThickness="1" CornerRadius="12" Padding="28">
      <StackPanel>
       <StackPanel Orientation="Horizontal"><Image Source="Assets/MultiMP3.ico" Width="64" Height="64" Margin="0,0,18,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="MultiMP3" FontSize="32" FontWeight="Bold"/><TextBlock Text="A ChudGPT App" Foreground="#c7ff3e" FontFamily="Consolas" FontSize="13" Margin="0,7,0,0"/></StackPanel></StackPanel>
       <TextBlock x:Name="AboutVersion" FontFamily="Consolas" Foreground="#979b95" Margin="0,22,0,0"/>
       <TextBlock Text="Your sound. Organized." FontSize="22" FontWeight="Bold" Margin="0,24,0,10"/>
       <TextBlock Text="MultiMP3 is a modern batch media and audio organizer and MP3 utility. Queue multiple supported links, organize downloads into albums, choose supported audio quality, and manage your download folders in one workspace." TextWrapping="Wrap" Foreground="#f4f3ed" LineHeight="23"/>
       <TextBlock Text="Review failed items in Error Log, retry your queue, and find completed files in History. The Amazon Music mode organizes purchased MP3 files already on your computer." TextWrapping="Wrap" Foreground="#979b95" LineHeight="23" Margin="0,14,0,0"/>
      </StackPanel>
     </Border>
     <Border BorderBrush="#292c28" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,18,0,18">
      <StackPanel><TextBlock Text="PART OF THE CHUDGPT ECOSYSTEM" FontFamily="Consolas" Foreground="#c7ff3e" FontSize="12"/><TextBlock Text="An independent audio workspace in the ChudGPT family of apps." TextWrapping="Wrap" Foreground="#979b95" Margin="0,12,0,16"/><Button Content="Explore the ChudGPT ecosystem  ↗" Click="VisitEcosystem" HorizontalAlignment="Left" Background="#c7ff3e" Foreground="#0b0c0b" ToolTip="https://chudgpt-landing.vercel.app/"/></StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" x:Name="ErrorsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button Content="Retry Failed" Click="RetryFailed" Background="#9385ff" Foreground="#0b0c0b" Margin="0,0,10,0"/><Button Content="Clear Log" Click="ClearErrors"/></StackPanel><ListBox Grid.Row="1" x:Name="ErrorsList"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="18"><DockPanel><Button DockPanel.Dock="Right" Content="Copy" Tag="{Binding}" Click="CopyError"/><TextBlock Text="{Binding Title}" FontSize="16"/></DockPanel><TextBlock Text="{Binding Time, StringFormat={}{0:g}}" Foreground="#9783A7"/><TextBlock Text="{Binding Reason}" Foreground="#ECA2AF" TextWrapping="Wrap" Margin="0,10"/><TextBlock Text="{Binding Url}" Foreground="#96859F" TextWrapping="Wrap"/><Expander Header="Technical details" Foreground="#B6A4C6" Margin="0,10,0,0"><TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyErrors" Grid.Row="1" Text="All clear. Any download errors will appear here." Foreground="#94869F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
   <Border x:Name="QueueFooter" Grid.Row="3" BorderBrush="#292c28" BorderThickness="0,1,0,0" Padding="0,17,0,0" Margin="0,18,0,0"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PauseButton" Content="Pause" Click="PauseDownloads" Margin="0,0,8,0" IsEnabled="False" ToolTip="Pause after active downloads finish"/><Button x:Name="CancelButton" Content="Cancel" Click="CancelDownloads" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="DownloadButton" Content="↓  Download All" Click="DownloadAll" Background="#9385ff" Foreground="#170F21" FontWeight="SemiBold"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Summary" Text="0 completed   ·   0 queued" FontSize="12"/><TextBlock x:Name="BatchLabel" Text="Ready when you are" Foreground="#979b95" FontSize="10" Margin="0,5,0,0"/></StackPanel></DockPanel><ProgressBar x:Name="BatchProgress" Margin="0,13,0,0"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
